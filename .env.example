OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Facebook Provider - mac dinh production la "apify" (khong con Playwright).
# Chi dat "playwright" o day khi CHU DONG muon chay lua chon du phong cuc bo
# (xem APIFY_SETUP_AND_TEST.md muc "Cach chuyen thu cong ve Playwright").
FACEBOOK_PROVIDER=apify

# Lay tai https://console.apify.com/settings/integrations - KHONG commit gia
# tri that cua bien nay len git (xem .gitignore: .env/.env.* da bi loai tru).
APIFY_API_TOKEN=

# Actor chinh thuc dung de thu thap Fanpage/bai viet Facebook.
APIFY_FACEBOOK_PAGES_ACTOR=apify/facebook-pages-scraper
APIFY_FACEBOOK_POSTS_ACTOR=apify/facebook-posts-scraper

# Co dinh 30 cho MVP (xem ARCHITECTURE.md/README.md muc quyet dinh moi) - du
# dat cao hon, he thong van hard-cap ve 30.
APIFY_MAX_POSTS=30

# Timeout (giay) cho MOI Actor run (Pages/Posts rieng) truoc khi coi la that bai.
APIFY_TIMEOUT_SECONDS=180

# Tuy chon - gioi han chi phi toi da (USD) cho 1 Actor run neu Actor tinh phi
# theo "pay-per-event". Bo trong neu khong can gioi han rieng.
APIFY_MAX_TOTAL_CHARGE_USD=
