OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Facebook Provider - mac dinh production la "apify" (khong con Playwright).
# Chi dat "playwright" o day khi CHU DONG muon chay lua chon du phong cuc bo
# (xem APIFY_SETUP_AND_TEST.md muc "Cach chuyen thu cong ve Playwright").
FACEBOOK_PROVIDER=apify

# Lay tai https://console.apify.com/settings/integrations - KHONG commit gia
# tri that cua bien nay len git (xem .gitignore: .env/.env.* da bi loai tru).
APIFY_API_TOKEN=

# Actor chinh thuc dung de thu thap Fanpage/bai viet Facebook.
APIFY_FACEBOOK_PAGES_ACTOR=apify/facebook-pages-scraper
APIFY_FACEBOOK_POSTS_ACTOR=apify/facebook-posts-scraper

# Co dinh 30 cho MVP (xem ARCHITECTURE.md/README.md muc quyet dinh moi) - du
# dat cao hon, he thong van hard-cap ve 30.
APIFY_MAX_POSTS=30

# Timeout (giay) cho MOI Actor run (Pages/Posts rieng) truoc khi coi la that bai.
APIFY_TIMEOUT_SECONDS=180

# Tuy chon - gioi han chi phi toi da (USD) cho 1 Actor run neu Actor tinh phi
# theo "pay-per-event". Bo trong neu khong can gioi han rieng.
APIFY_MAX_TOTAL_CHARGE_USD=

# ---------------------------------------------------------------------------
# Sprint V3.2 - Social Competitor Benchmark (v3/)
# ---------------------------------------------------------------------------

# Bat/tat toan bo route /api/v3/* (feature flag) - uu tien bien nay hon
# config.json.enable_social_benchmark. Dat "false" de rollback nhanh khong
# can deploy lai neu can.
ENABLE_SOCIAL_BENCHMARK=true

# Vi tri file SQLite Ver 3 - mac dinh data/v3.db (tuong doi voi repo). Dat
# gia tri khac (vd ":memory:" cho 1 lan test rieng le, hoac 1 duong dan
# file khac) khi can co lap moi truong. CHI dung khi DATABASE_URL o duoi
# KHONG duoc dat (xem V3_DB_PATH vs DATABASE_URL ben duoi).
V3_DB_PATH=

# ---------------------------------------------------------------------------
# Sprint V3.3.1 - PostgreSQL production persistence (v3/db.py)
# ---------------------------------------------------------------------------

# Dat bien nay -> v3/db.py TU DONG chuyen toan bo Ver 3 sang PostgreSQL (bo
# qua V3_DB_PATH/SQLite hoan toan cho ket noi mac dinh). De TRONG -> tiep tuc
# dung SQLite (V3_DB_PATH o tren) - dung cho local dev/test, KHONG dung cho
# production that (xem blocker #1 trong V3_SPRINT_02_REPORT.md muc F: SQLite
# tren Render free mat du lieu moi lan deploy/restart).
#
# Dinh dang chuan: postgresql://<user>:<password>@<host>:<port>/<database>
# Tren Render: dat bang cach gan Render Postgres qua render.yaml
# (fromDatabase.property: connectionString) - KHONG hard-code credential o
# day, chi de placeholder rong trong .env.example (xem .gitignore: .env
# that KHONG duoc commit).
#
# Local dev voi Postgres that (tuy chon, xem V3_DATABASE_MIGRATION_GUIDE.md
# muc "Chay Postgres local"):
#   docker run --name cic-v3-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=cic_v3 -p 5432:5432 -d postgres:16
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cic_v3
DATABASE_URL=

# LinkedIn/TikTok Provider - mac dinh "manual_import". "mock" CHI dung
# dev/demo cuc bo, KHONG dat tren production. "external" = Apify THAT (moi
# o Sprint V3.3.2 - xem docs/ver3/V3_SPRINT_032_REPORT.md), can
# APIFY_API_TOKEN + APIFY_LINKEDIN_ACTOR_ID/APIFY_TIKTOK_ACTOR_ID o duoi.
LINKEDIN_PROVIDER=manual_import
TIKTOK_PROVIDER=manual_import

# ---------------------------------------------------------------------------
# Sprint V3.3.2 - LinkedIn/TikTok Apify Provider that (LINKEDIN_PROVIDER=
# external / TIKTOK_PROVIDER=external)
# ---------------------------------------------------------------------------

# DUNG CHUNG APIFY_API_TOKEN o tren voi Facebook - KHONG co bien token rieng
# cho LinkedIn/TikTok (1 tai khoan Apify, 1 token duy nhat).

# Actor "LinkedIn Company Posts Scraper (No Cookies)" cua harvestapi - actor
# id xac nhan qua Apify API (KHONG doan tu ten hien thi), de trong se dung
# gia tri mac dinh harvestapi/linkedin-company-posts trong code.
APIFY_LINKEDIN_ACTOR_ID=harvestapi/linkedin-company-posts

# Actor "Fast TikTok Scraper API | Influencer Data & Analytics API" cua
# apidojo - actor id xac nhan qua Apify API. CANH BAO: Actor nay tu choi goi
# qua API tren tai khoan Apify goi Free (tra ve du lieu demo, KHONG phai du
# lieu that) - can tai khoan Apify goi tra phi de dung that (xem
# docs/ver3/V3_SPRINT_032_REPORT.md muc E va
# docs/ver3/V3_COLLECTION_PROVIDER_GUIDE.md).
APIFY_TIKTOK_ACTOR_ID=apidojo/tiktok-scraper-api

# Timeout (giay) cho MOI Actor run cua LinkedIn/TikTok - RIENG voi
# APIFY_TIMEOUT_SECONDS cua Facebook (Ver 2, khong doi) de tranh anh huong
# hanh vi Facebook hien co.
APIFY_RUN_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Sprint V3.3.4 - CORS production + Idempotency-Key
# ---------------------------------------------------------------------------

# Danh sach domain duoc phep goi API (CORS), cach nhau boi dau phay - KHONG
# dung wildcard "*" cho production neu khong can. De trong -> mac dinh CHI
# "https://edu.linkpower.vn" (xem main.py:_parse_allowed_origins()). Muon
# them localhost/preview domain khi test, dat vi du:
#   ALLOWED_ORIGINS=https://edu.linkpower.vn,http://localhost:3000
ALLOWED_ORIGINS=https://edu.linkpower.vn

# Thoi han (gio) cho 1 Idempotency-Key luu trong bang idempotency_keys truoc
# khi coi nhu chua tung dung - mac dinh 24h, du cho nguoi dung double-click/
# mang cham. Xem v3/services/idempotency_service.py.
IDEMPOTENCY_KEY_TTL_HOURS=24
